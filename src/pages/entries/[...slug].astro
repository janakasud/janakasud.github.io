
---
// src/pages/entries/[...slug].astro
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("entries", ({ data }) => !data.draft);

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// Show H2 headings in the sidebar.
const toc = headings.filter((heading) => heading.depth === 2);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <main class="container container-home entry-layout">

    {toc.length >= 2 && (
      <aside class="toc" aria-label="Table of contents">
        <nav aria-label="On this page">
          <p class="toc-title">On this page</p>

          <ul>
            {toc.map((heading) => (
              <li>
                <a href={`#${heading.slug}`}>
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    )}

    <article class:list={["notebook-entry", { "no-toc": toc.length < 2 }]}>
      <header class="entry-header">
        <h1>{entry.data.title}</h1>

        <div class="meta">
          <time datetime={entry.data.pubDate.toISOString()}>
            {entry.data.pubDate.toLocaleDateString("en-AU", {
              day: "numeric",
              month: "long",
              year: "numeric",
              timeZone: "UTC",
            })}
          </time>

          {entry.data.tags.length > 0 && (
            <div class="tags" aria-label="Topics">
              {entry.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )}
        </div>
      </header>

      <div class="prose">
        <Content />
      </div>
    </article>

  </main>
</BaseLayout>

<style>
  .entry-layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 800px);
    gap: 48px;
    padding-top: 40px;
    padding-bottom: 64px;
    align-items: start;
  }

  /* TOC */
  .toc {
    position: sticky;
    top: 88px;
    max-height: calc(100vh - 110px);
    overflow-y: auto;
    font-size: 0.875rem;
  }

  .toc-title {
    margin: 0 0 16px;
    font-weight: 600;
    color: var(--text);
  }

  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0 0 0 14px;
    border-left: 1px solid var(--border);
  }

  .toc li {
    margin: 0 0 12px;
    line-height: 1.45;
  }

  .toc a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--accent);
  }

  /* Article */
  .notebook-entry {
    min-width: 0;
    max-width: 800px;
  }

  .entry-header {
    margin-bottom: var(--space-6);
  }

  .entry-header h1 {
    margin: 0 0 var(--space-3);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    line-height: 1.2;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag + .tag::before {
    content: "·";
    margin-right: var(--space-2);
  }

  /* Hide empty TOC column */
  .no-toc {
    grid-column: 2;
  }

  /* Tablet and mobile */
  @media (max-width: 900px) {
    .entry-layout {
      grid-template-columns: 1fr;
      gap: 24px;
      padding-top: 24px;
    }

    .toc {
      position: static;
      max-height: none;
    }

    .toc nav {
      padding-bottom: 16px;
      border-bottom: 1px solid var(--border);
    }

    .no-toc {
      grid-column: 1;
    }
  }
</style>
