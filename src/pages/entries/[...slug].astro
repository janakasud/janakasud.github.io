---
// src/pages/entries/[...slug].astro
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("entries", ({ data }) => !data.draft);

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// Show H2 headings in the sidebar.
const toc = headings.filter((heading) => heading.depth === 2);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <main class:list={["container", "container-home", "entry-layout", { "without-toc": toc.length < 2 }]}>

    <article class:list={["notebook-entry", { "no-toc": toc.length < 2 }]}>
      <header class="entry-header">
        <h1>{entry.data.title}</h1>

        <div class="meta">
          {entry.data.tags.length > 0 && (
            <div class="tags" aria-label="Topics">
              {entry.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )}
          <time class:list={{ "has-tags": entry.data.tags.length > 0 }} datetime={entry.data.pubDate.toISOString()}>
            {entry.data.pubDate.toLocaleDateString("en-AU", {
              day: "numeric",
              month: "short",
              year: "numeric",
              timeZone: "UTC",
            })}
          </time>
        </div>
      </header>

      <div class="prose">
        <Content />
      </div>
    </article>

    {toc.length >= 2 && (
      <aside class="toc" aria-label="Table of contents">
        <details open>
          <summary class="toc-title">On this page</summary>
          <nav aria-label="On this page">
            <ul>
              {toc.map((heading) => (
                <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
              ))}
            </ul>
          </nav>
        </details>
      </aside>
    )}

  </main>
</BaseLayout>

<style>
  .entry-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    grid-template-areas: "article sidebar";
    gap: 48px;
    padding-top: 40px;
    padding-bottom: 64px;
    align-items: start;
  }

  /* TOC */
  .toc {
    grid-area: sidebar;
    min-width: 0;
    position: sticky;
    top: 88px;
    max-height: calc(100vh - 110px);
    overflow-y: auto;
    font-size: 0.875rem;
  }

  .toc-title {
    display: block;
    list-style: none;
    pointer-events: none;
    margin: 0 0 16px;
    font-weight: 600;
    color: var(--text);
  }

  .toc-title::-webkit-details-marker { display: none; }

  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0 0 0 14px;
    border-left: 1px solid var(--border);
  }

  .toc li {
    margin: 0 0 12px;
    line-height: 1.45;
  }

  .toc a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--accent);
  }

  /* Article */
  .notebook-entry {
    grid-area: article;
    min-width: 0;
    max-width: 800px;
  }

  .entry-header {
    margin-bottom: var(--space-6);
  }

  .entry-header h1 {
    margin: 0 0 var(--space-3);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    line-height: 1.2;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 5px 0;
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px 16px;
  }

  .meta time.has-tags::before {
    content: "·";
    margin: 0 12px;
  }


  .entry-layout.without-toc { grid-template-areas: "article ."; }

  /* Tablet and mobile */
  @media (max-width: 900px) {
    .entry-layout {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "sidebar" "article";
      gap: 24px;
      padding-top: 24px;
    }

    .entry-layout.without-toc { grid-template-areas: "article"; }

    .toc {
      position: static;
      max-height: none;
    }

    .toc details {
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border);
    }

    .toc-title { pointer-events: auto; cursor: pointer; margin-bottom: 0; }
    .toc details[open] .toc-title { margin-bottom: 12px; }
    .toc-title::after { content: " +"; }
    .toc details[open] .toc-title::after { content: " −"; }
  }
</style>
